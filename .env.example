# Server-only secrets. Never prefix these with VITE_ or NEXT_PUBLIC_. Copy to .env.local.
DATA_GOV_IN_API_KEY=
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Only for an alternate resource after verifying its official contract.
DATA_GOV_MANDI_VERIFIED_RESOURCE_ID=
# Optional, only after verifying the configured resource's commodity units.
# Keep {} until verified. Example shape: {"Wheat":"quintal"}
DATA_GOV_VERIFIED_UNITS_JSON={}
DATA_GOV_UNIT_SOURCE_URL=
API_PORT=8787
WEATHER_ENABLED=true
# Optional commercial Open-Meteo subscription key; evaluation uses the public endpoint.
OPEN_METEO_API_KEY=
# Default: explicitly labelled browser compatibility fallback; no paid requests.
SPEECH_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL=scribe_v2
# Requires an eligible enterprise plan. false requires explicit provider-retention consent in Ask.
ELEVENLABS_ZERO_RETENTION=true
